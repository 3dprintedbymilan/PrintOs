# Copy to .env to override. All values have working defaults in docker-compose.yml.
POSTGRES_DB=printos
POSTGRES_USER=printos
POSTGRES_PASSWORD=printos
POSTGRES_PORT=5432

# S3-compatible object storage (SeaweedFS locally)
S3_ACCESS_KEY=printos
S3_SECRET_KEY=printos-secret
S3_BUCKET=printos
S3_PORT=8333

API_PORT=5000
WEB_PORT=3000
